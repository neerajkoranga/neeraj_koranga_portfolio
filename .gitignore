# Root .gitignore
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.iml

# Node / Angular
**/node_modules/
**/dist/
**/.angular/
frontend/.angular/cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java / Maven
**/target/
**/.mvn/
backend/uploads/*
!backend/uploads/.gitkeep

# Environment
.env
.env.local
